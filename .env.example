# Copy to .env (git-ignored). All values are optional - the agent needs NO API keys.

# Where results, tracker database and memory are stored (default: ./workspace)
JOBHUNT_HOME=workspace

# Phone push notifications via https://ntfy.sh - pick a long, secret topic name and subscribe to it in the ntfy app
JOBHUNT_NTFY_TOPIC=

# Slack / Microsoft Teams / Discord incoming-webhook URL (treat it like a password)
JOBHUNT_WEBHOOK_URL=

# 1 = also show desktop notifications (needs `notify-send` on Linux, or works via PowerShell on Windows)
JOBHUNT_DESKTOP=0
